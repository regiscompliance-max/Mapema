{
  "name": "mapema-platform",
  "private": true,
  "version": "0.1.0",
  "description": "Mapema buyer-led supplier early-payment platform (Phase 1: lending core MVP)",
  "workspaces": [
    "packages/pricing",
    "packages/adapters",
    "apps/api",
    "apps/worker",
    "apps/web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build -w @mapema/pricing -w @mapema/adapters && npm run build -w @mapema/api -w @mapema/worker && npm run build -w @mapema/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint:openapi": "redocly lint openapi/openapi.yaml openapi/phase-0-design.yaml",
    "test": "npm run test -w @mapema/pricing -w @mapema/adapters -w @mapema/api -w @mapema/worker -w @mapema/web",
    "test:unit": "npm run test -w @mapema/pricing -w @mapema/adapters",
    "test:api": "npm run test -w @mapema/api",
    "test:fineract": "npm run test:fineract -w @mapema/adapters",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "dev:api": "npm run dev -w @mapema/api",
    "dev:web": "npm run dev -w @mapema/web",
    "dev:worker": "npm run dev -w @mapema/worker",
    "openapi:gen": "node scripts/gen-openapi.mjs",
    "test:e2e:fineract": "E2E_LEDGER=fineract npm run test -w @mapema/api",
    "test:worker": "npm run test -w @mapema/worker",
    "lint": "eslint . --max-warnings=0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@redocly/cli": "^2.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.73.0"
  }
}
