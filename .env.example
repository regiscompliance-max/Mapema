# Mapema platform - environment variables (Phase 1-3). NO REAL SECRETS IN THIS FILE.
# Copy to .env for local development. Generate 32-byte hex keys with:  openssl rand -hex 32
# In staging/production every secret comes from the secret manager, never from a file.

# --- runtime
APP_ENV=development                 # development | test | staging | production
PORT=4000
WEB_ORIGIN=http://localhost:3000    # the only CORS origin allowed

# --- database (the API/worker log in as a role that is a member of mapema_app - never a superuser)
DATABASE_URL=postgres://mapema_api:change-me-local-only@localhost:5432/mapema
# Used by scripts/seed.mjs, migrations and the API test harness (creates throw-away DBs). Superuser/owner.
DATABASE_ADMIN_URL=postgres://postgres:change-me-local-only@localhost:5432/mapema
TEST_DATABASE_ADMIN_URL=postgres://postgres:change-me-local-only@localhost:5432/postgres
APP_DB_LOGIN_PASSWORD=change-me-local-only   # seed.mjs creates/updates login role mapema_api with this password

# --- identity (Keycloak in staging/production; the dev IdP is refused when APP_ENV=production)
OIDC_ISSUER=http://localhost:4000/dev-idp       # e.g. https://auth.staging.mapema.example/realms/mapema
OIDC_AUDIENCE=mapema-api
OIDC_JWKS_URL=                                  # defaults to <issuer>/protocol/openid-connect/certs for Keycloak
DEV_IDP_ENABLED=true                            # development/test only
STEP_UP_MAX_AGE_SEC=300                         # releases, recourse, funding need a sign-in this recent
# Browser sessions (Phase 1b): httpOnly Secure SameSite=Strict cookie, server-side session, CSRF token
SESSION_IDLE_MINUTES=15
SESSION_MAX_HOURS=8
# Rate limiting shared by all API instances through Postgres (memory = per instance, single-instance dev only)
RATE_LIMIT_STORE=postgres

# --- encryption (AES-256-GCM for PII and stored documents; HMAC blind index for lookups)
PII_ENCRYPTION_KEY=<64 hex chars>
PII_BLIND_INDEX_KEY=<64 hex chars>
STORAGE_ENCRYPTION_KEY=<64 hex chars>
STORAGE_DIR=./storage-local                     # local encrypted file store (S3-compatible store not built in Phase 1)

# --- business settings
INVITE_TTL_HOURS=72
QUOTE_TTL_MINUTES=30
BANK_ACCOUNT_COOLING_OFF_HOURS=24
KYC_REFRESH_MONTHS=12                           # CRD-07: KYC checks valid this long; reminders 30/7 days before; blocked on expiry (policy default, D-35)

# --- adapters: mock | sandbox | live  (live only when APP_ENV=production; production refuses mock)
ADAPTER_MODE_LEDGER=mock
ADAPTER_MODE_BANK=mock
ADAPTER_MODE_ETIMS=mock
ADAPTER_MODE_CRB=mock
ADAPTER_MODE_KYC=mock
ADAPTER_MODE_ESIGN=mock
ADAPTER_MODE_SMS=mock
ADAPTER_MODE_EMAIL=mock
ADAPTER_MODE_ACCOUNTING=mock                    # Phase 2: Xero (sandbox = Xero demo company); QuickBooks would be a second implementation
ADAPTER_MODE_CRM=mock                           # Phase 2: HubSpot (sandbox = HubSpot developer test account)
ADAPTER_MODE_SITE_LEADS=mock                    # Phase 2: the site's D1 book-a-call table (sandbox = read-only D1 query API)
ESIGN_MOCK_AUTOCOMPLETE=false

# Fineract (ADAPTER_MODE_LEDGER=sandbox). The demo login below is Fineract's public local default - local only.
FINERACT_BASE_URL=http://localhost:8443/fineract-provider/api/v1
FINERACT_TENANT=default
FINERACT_USERNAME=mifos
FINERACT_PASSWORD=password
E2E_LEDGER=mock                                 # set to fineract to run the E2E suites against real Fineract

# Webhook HMAC secrets (bank, e-sign)
BANK_WEBHOOK_SECRET=<at least 16 chars>
ESIGN_WEBHOOK_SECRET=<at least 16 chars>

# Africa's Talking SMS (sandbox) and Postmark email - adapters exist, not exercised in Phase 1 (no accounts created)
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
POSTMARK_SERVER_TOKEN=
EMAIL_FROM=no-reply@mapema.example

# --- Phase 2 integrations (no accounts created; leave empty for mock mode)
XERO_ACCESS_TOKEN=                              # OAuth2 access token for the Xero org (Q-E); refreshed outside the app
XERO_TENANT_ID=
ACCOUNTING_GL_MAP=                              # optional JSON {"bank":"090","loans_receivable":"610",...}; default = Mapema GL codes (accountant to confirm, Q-E)
HUBSPOT_PRIVATE_APP_TOKEN=                      # HubSpot private app token, scopes crm.objects.contacts/deals write (Q-F)
HUBSPOT_BUYER_PIPELINE_ID=
HUBSPOT_BUYER_DEAL_STAGE_ID=
SITE_D1_ACCOUNT_ID=                             # Cloudflare account of the marketing site
SITE_D1_DATABASE_ID=                            # D1 database mapema-site
SITE_D1_API_TOKEN=                              # Cloudflare API token scoped to D1 read on that database only (Q-F)

# --- Phase 2 reporting
CRB_SUBMISSION_REQUIRE_CONSENT=true             # exclude borrowers without CRB consent on file from the CRB file (counsel to confirm, Q-C)

# --- Phase 3 growth (no accounts created; mock is the default and needs none of the values below)
ADAPTER_MODE_ERP=mock                           # mock | sandbox (Odoo JSON-RPC / CSV drop folder / SAP, Sage, Dynamics assumed shapes) | live
ERP_DROP_ROOT=/var/lib/mapema/erp-drop          # CSV/SFTP drop: <root>/<connectionId>/incoming|processed|rejected (SFTP server writes here; no remote pull)
# One variable per ERP connection; the connection stores only the NAME (must start with ERP_SECRET_), never the key.
# ERP_SECRET_ACME_ODOO=                         # e.g. the Odoo API key of the integration user (secret manager in staging/production)
ADAPTER_MODE_MPESA=mock                         # mock | sandbox (Daraja sandbox) | live (production only, after counsel + Safaricom onboarding)
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=                      # initiator password encrypted with the Safaricom certificate
MPESA_CALLBACK_BASE_URL=http://localhost:4000   # result/timeout URLs = <base>/v1/webhooks/mpesa/b2c/{result|timeout}/<token>
MPESA_CALLBACK_TOKEN=                           # >= 24 random chars; Daraja does not sign callbacks, so the path token authenticates them
MPESA_RESULT_TIMEOUT_MINUTES=30                 # after this a pending payout is queried (never resent)

# --- go-live hardening
# D-32 server-side OIDC (BFF). The browser never sees a token: the API does the code exchange.
OIDC_CLIENT_ID=mapema-web
OIDC_CLIENT_SECRET=                             # confidential client secret (>= 16 chars; secret manager in staging/production)
OIDC_REDIRECT_URI=http://localhost:4000/v1/auth/oidc/callback   # https required in staging/production
# OIDC_AUTH_URL= / OIDC_TOKEN_URL=              # optional overrides; default <OIDC_ISSUER>/protocol/openid-connect/{auth,token}
# OIDC_SCOPES=openid email
# OIDC_BFF_WITH_DEV_IDP=false                   # local testing only: mount the BFF while the dev IdP is on
# S-12 M-Pesa callback token rotation and source check
MPESA_CALLBACK_TOKEN_PREVIOUS=                  # accepted during a rotation window; every use is audited
MPESA_CALLBACK_ALLOWED_IPS=                     # comma-separated IPs/CIDRs of Safaricom's callback sources (from Safaricom); empty = not checked
# S-13 ERP egress allow-list (SSRF): exact hosts or *.suffix; empty = no outbound ERP calls at all
ERP_ALLOWED_HOSTS=
ERP_ALLOW_HTTP=false                            # http:// ERP URLs only when APP_ENV is development/test
# S-16 antivirus for CSV drop files
ADAPTER_MODE_AV=mock                            # mock (EICAR test string only; refused in production) | clamd
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310
# S-15 batch approvals: the step-up must be at most this old when each item releases
BATCH_STEP_UP_WINDOW_SEC=900                    # min 60
# S-09 report artefacts are sealed with a key derived from STORAGE_ENCRYPTION_KEY; existing rows: node scripts/encrypt-report-artifacts.mjs

# --- web (Next.js, public values only)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_DEV_SIGNIN=true                     # shows the dev sign-in form; false in staging/production
NEXT_PUBLIC_OIDC_ENABLED=false                  # true in staging/production: the sign-in button starts the API's BFF flow (D-32)

# --- seed (scripts/seed.mjs)
SEED_API_URL=http://localhost:4000              # when set, the seed also builds the demo world through the API
SEED_DEMO_MONTH=                                # Phase 2: e.g. 2026-10 builds a full demo month (reports, recon, collections) instead
SEED_DEMO_GROWTH=                               # Phase 3: true builds the growth demo (funding sources, mock Odoo import, M-Pesa payout, bulk + payout batch)
